---
title: System Architecture - Statistical Translation
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#EEF2FF"
    clusterBorder: "#94A3B8"
---
flowchart TB
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client([Client]):::edge

    subgraph Train["Training by expectation-maximization (startup)"]
        direction TB
        Corpus[(Parallel corpus)]:::data
        Model1["IBM Model 1<br/>t(target | source), convex EM"]:::core
        Model2["IBM Model 2<br/>+ q(i | j, l, m) position model"]:::core
    end

    Tables[(Translation + alignment tables)]:::data

    subgraph Edge["Service layer (stdlib HTTP, stateless)"]
        direction TB
        Router["Router<br/>/health | /ready | /metrics | /align | /translate | /evaluate"]:::core
        Validate["Validation<br/>bounded text, bounded k"]:::control
    end

    Align["Most probable alignment<br/>argmax t x q"]:::core
    Result["Word alignment / translations<br/>+ AER"]:::obs

    Corpus --> Model1 --> Model2 -->|tables| Tables
    Client -->|JSON request| Router --> Validate
    Validate --> Align
    Tables -.-> Align
    Align --> Result
    Result --> Router -->|JSON response| Client

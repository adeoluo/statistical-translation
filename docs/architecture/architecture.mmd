flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        CLI["CLI<br/>evaluate, align, serve"]:::edge
        Client(["HTTP client"]):::edge
        Router["HTTP router<br/>/align /translate"]:::core
        Validate["Validation<br/>text, length, k"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph Corpus["Bundled corpus"]
        direction TB
        Pairs[("Parallel pairs<br/>English to pseudo-French")]:::data
        Tokenize["Tokenizer<br/>words + NULL token"]:::core
        Gold[("Gold sure links<br/>held-out pairs")]:::data
        Pairs --> Tokenize ~~~ Gold
    end

    subgraph Train["EM training (at startup)"]
        direction TB
        M1["IBM Model 1 EM<br/>learns t(f | e)"]:::core
        M2["IBM Model 2 EM<br/>adds q(i | j, l, m)"]:::core
        T1[("Model 1 table<br/>t")]:::data
        T2[("Model 2 tables<br/>t and q")]:::data
        M1 --> T1 ~~~ M2 --> T2
    end

    subgraph Obs["Inference and evaluation"]
        direction TB
        Align["Word alignment<br/>argmax q x t"]:::core
        Translate["Word translation<br/>top-k by t"]:::core
        AER["Alignment error rate<br/>Model 1 vs Model 2"]:::obs
        Metrics["Route metrics<br/>Prometheus text"]:::obs
        Translate ~~~ Align --> AER ~~~ Metrics
    end

    Interfaces -->|train models| Train
    Corpus -->|tokens + NULL| Train
    Train -->|learned tables| Obs
